# BrowserStack Credentials
# Deze file mag NIET in git commit worden! (.gitignore toevoegen)
BROWSERSTACK_USERNAME=your_username
BROWSERSTACK_ACCESS_KEY=your_access_key

# NPO CMS API Authentication
# JWT Bearer Token van SSO login
# Verkrijg token via: https://sso.tst.cms.bijnpo.nl/auth/realms/NPO-CMS-TST/protocol/openid-connect/auth
LUISTER_CMS_API_TOKEN=your_jwt_bearer_token_here

# Alternative token name
NPO_API_TOKEN=your_jwt_bearer_token_here

# Base URL (optional, defaults to https://tst.luister-cms.api.npox.nl)
BASE_URL=https://tst.luister-cms.api.npox.nl

# CI/CD environments
CI=false
